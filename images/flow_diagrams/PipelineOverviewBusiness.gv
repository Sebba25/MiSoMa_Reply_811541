digraph PipelineOverviewBusiness {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.9",
    splines=polyline,
    newrank=true,
    fontname="Helvetica"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=16,
    color="#213547",
    penwidth=1.4,
    margin="0.22,0.16"
  ];

  edge [
    color="#587086",
    penwidth=1.6,
    arrowsize=0.8,
    fontname="Helvetica",
    fontsize=11
  ];

  input [
    label="Raw Dataset",
    fillcolor="#DFF3E4"
  ];

  checks [
    label="1. Automated Quality Checks\n\nProfile structure, completeness,\nconsistency, anomalies, and duplicates",
    fillcolor="#EAF6E0"
  ];

  assessment [
    label="2. Risk-Based Assessment\n\nSeparate routine defects from\nambiguous or high-impact cases",
    fillcolor="#E7F5E7"
  ];

  ai_fix [
    label="3. Controlled AI Remediation\n\nGenerate narrowly scoped fixes\nonly where bounded reasoning adds value",
    fillcolor="#D8F0D2"
  ];

  validation [
    label="4. Host-Side Validation\n\nVerify syntax, safety rules,\nand preservation constraints",
    fillcolor="#EAF6E0"
  ];

  apply [
    label="5. Apply Approved Changes",
    fillcolor="#DFF3E4"
  ];

  verify [
    label="6. Post-Change Verification\n\nRe-check targeted issues and confirm\nthat quality improved without regressions",
    fillcolor="#D8F0D2"
  ];

  cleaned [
    label="Cleaned Dataset",
    fillcolor="#BEE7A6"
  ];

  report [
    label="Audit-Ready Quality Report",
    fillcolor="#BEE7A6"
  ];

  review [
    label="Manual Review Queue",
    fillcolor="#F5F5F5"
  ];

  routine_note [
    label="Routine, defensible fixes\ncan be auto-approved",
    shape=note,
    style="filled",
    fillcolor="#F7FBF2",
    color="#9FB788",
    fontsize=12,
    margin="0.18,0.12"
  ];

  governance_note [
    label="Deterministic evidence + bounded AI + verification",
    shape=note,
    style="filled",
    fillcolor="#F7FBF2",
    color="#9FB788",
    fontsize=12,
    margin="0.18,0.12"
  ];

  input -> checks;
  checks -> assessment;
  assessment -> ai_fix;
  ai_fix -> validation;
  validation -> apply;
  apply -> verify;
  verify -> cleaned;
  verify -> report;

  assessment -> review [label="Ambiguous or high-risk issues", style=dashed, color="#8A8A8A"];
  assessment -> routine_note [style=dashed, arrowhead=none, color="#A1B48E"];
  validation -> governance_note [style=dashed, arrowhead=none, color="#A1B48E"];

  { rank=same; input; checks; assessment }
  { rank=same; ai_fix; validation; apply; verify }
  { rank=same; cleaned; report }
}
